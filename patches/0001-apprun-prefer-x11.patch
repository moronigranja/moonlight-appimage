--- a/scripts/build-appimage.sh
+++ b/scripts/build-appimage.sh
@@ -111,6 +111,13 @@
 APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
 LIBVA_FALLBACK="$APPDIR/opt/libva-fallback"
 
+# This AppImage is built without Qt's Wayland support (see CONFIG+=disable-wayland above).
+# When an X server is reachable, pin SDL to it as well, so the video window uses the same
+# backend as the UI instead of SDL choosing Wayland on its own.
+if [ -n "${DISPLAY:-}" ] && [ -z "${SDL_VIDEODRIVER:-}" ]; then
+    export SDL_VIDEODRIVER=x11
+fi
+
 if [ -d "$LIBVA_FALLBACK" ] && ! "$LIBVA_FALLBACK/libva-probe" 2>/dev/null; then
     export LD_LIBRARY_PATH="$LIBVA_FALLBACK${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
     export VAAPI_USE_FALLBACK_PATHS=1
